# ── External pathology API ───────────────────────────────────────────────────
EXTERNAL_API_BASE_URL=https://your-pathology-api.example.com #use mock here to switch to testing mode.
EXTERNAL_API_EMAIL=viewer-service@example.com
EXTERNAL_API_PASSWORD=changeme

# ── Session lifecycle ────────────────────────────────────────────────────────
# How often (minutes) to re-fetch signed GCS URLs (before they expire)
WSI_URL_REFRESH_MINUTES=10
# How long (minutes) before an idle session is evicted from memory
SESSION_TTL=30

# ── Google Cloud Storage ─────────────────────────────────────────────────────
# Project ID used when creating the GCS client
GCP_PROJECT_ID=your-gcp-project-id
# If set, this service account email is used to sign GCS URLs
# (requires iam.serviceAccounts.signBlob permission)
GCS_SERVICE_ACCOUNT_EMAIL=
# How long signed GCS URLs are valid (seconds)
GCS_SIGNED_URL_TTL_SECONDS=3600

# ── TCA overlay cache ────────────────────────────────────────────────────────
# Directory where TCA zip files are extracted to
OVERLAY_CACHE_DIR=/tmp/wsi_overlays

# ── Thumbnail cache ──────────────────────────────────────────────────────────
# Directory where generated slide overview PNGs are cached (ThumbnailService)
THUMBNAIL_CACHE_DIR=/tmp/wsi_thumbnails

# ── Normalized slide cache ───────────────────────────────────────────────────
# Directory where re-encoded pyramidal TIFFs are cached for slide formats the
# client-side viewer doesn't handle well (SlideNormalizationService). The
# original slide file is never modified.
NORMALIZED_SLIDE_CACHE_DIR=/tmp/wsi_normalized_slides

# ── Mock / local mode ────────────────────────────────────────────────────────
# Set EXTERNAL_API_BASE_URL=mock above to enable local testing without a real
# pathology API or GCS bucket — slides are served straight from local disk.
# Directory containing local .tiff/.svs/.ndpi files to serve as mock slides.
MOCK_SLIDE_DIR=mock_slides
# Base URL the mock client embeds in slide_url values — must match where this
# FastAPI server is actually reachable (used only in mock mode).
MOCK_BASE_URL=http://localhost:8080

# ── Server ───────────────────────────────────────────────────────────────────
# Root path prefix (for reverse proxy deployments, e.g. Cloud Run with a path)
ROOT_PATH=
PORT=8080
